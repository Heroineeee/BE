<?xml version="1.0" encoding="UTF-8" ?>
<configuration>
    <springProperty scope="context" name="PROFILE_NAME" source="spring.profiles.active"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight(%-5level) [%thread] %magenta([%logger{36}]) : %msg%n</pattern>
        </encoder>
    </appender>

    <!--로컬 환경에서의 로그 설정-->
    <springProfile name="local">
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="DEBUG"/>
        <logger name="com.kkinikong.be" level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!--배포 환경에서의 로그 설정-->
    <springProfile name="prod">
        <property resource="application-prod.yml"/>
        <springProperty name="DISCORD_WEBHOOK_URL" source="logging.discord.webhook-url"/>

        <logger name="org.hibernate.SQL" level="OFF"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="OFF"/>

        <logger name="com.kkinikong.be" level="INFO"/>
        <logger name="com.kkinikong.be.global.logging.LoggingAspect" level="OFF"/>

        <!--500 에러 디스코드 알림 설정-->
        <appender name="DISCORD" class="com.github.napstr.logback.DiscordAppender">
            <webhookUri>${DISCORD_WEBHOOK_URL}</webhookUri>
            <layout class="ch.qos.logback.classic.PatternLayout">
                <pattern>[%d{yyyy-MM-dd HH:mm:ss}] %-5level %logger{36} - %msg%n```%ex{10}```</pattern>
            </layout>
            <username>🚨 끼니콩 서버 에러 알림</username>
            <tts>false</tts>
        </appender>

        <appender name="ASYNC_DISCORD" class="ch.qos.logback.classic.AsyncAppender">
            <appender-ref ref="DISCORD"/>
            <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
                <level>ERROR</level>
            </filter>
        </appender>

        <logger name="ErrorLogger" level="INFO" additivity="false">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="ASYNC_DISCORD"/>
        </logger>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>